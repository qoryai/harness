{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extensions.software-factory",
  "description": "Every key that a repository can set under harness.extensions.software-factory of its qory.yaml, with its shape. A key that is not set changes nothing; no key is null.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "remove_kinds": {
      "description": "Kinds of the fast track to remove, by their names in short-path.json.",
      "type": "array",
      "items": { "type": "string" }
    },
    "remove_sensitive_areas": {
      "description": "Sensitive areas to remove, by their names in short-path.json.",
      "type": "array",
      "items": { "type": "string" }
    },
    "add_sensitive_areas": {
      "description": "Sensitive areas to add, each with a name and the file patterns of its files.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "patterns"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\u0000-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890\u0891\u08e2\u180e\u200b\u200e\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]+$"
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\u0000-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890\u0891\u08e2\u180e\u200b\u200e\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]+$"
            }
          }
        }
      }
    },
    "command_limits_minutes": {
      "description": "The time limits of the checks' commands, in whole minutes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full_suite": { "type": "integer", "minimum": 1, "maximum": 60 },
        "fast_checks": { "type": "integer", "minimum": 1, "maximum": 60 },
        "targeted_checks": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    }
  }
}
