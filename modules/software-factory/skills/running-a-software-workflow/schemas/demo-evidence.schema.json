{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Demo evidence, version 1",
  "description": "One demo scenario's verdict on one commit.",
  "type": "object",
  "required": [
    "scenario",
    "title",
    "commit",
    "planned",
    "evidence",
    "verdict",
    "script",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "scenario": {
      "type": "string",
      "pattern": "^scenario-[1-9][0-9]?$"
    },
    "title": {
      "type": "string",
      "$ref": "#/$defs/line",
      "minLength": 1,
      "maxLength": 500
    },
    "commit": {
      "$ref": "#/$defs/commit"
    },
    "planned": {
      "enum": [
        "film",
        "pictures"
      ]
    },
    "evidence": {
      "enum": [
        "film",
        "pictures",
        "none"
      ]
    },
    "verdict": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "class": {
      "enum": [
        "product",
        "script",
        "setup"
      ]
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "script": {
      "$ref": "#/$defs/version"
    },
    "media": {
      "$ref": "#/$defs/version"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "class"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "enum": [
              "film",
              "pictures"
            ]
          }
        }
      },
      "then": {
        "required": [
          "media"
        ]
      }
    }
  ],
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "step",
        "title",
        "expected",
        "verdict",
        "frames"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "title": {
          "type": "string",
          "$ref": "#/$defs/line",
          "minLength": 1,
          "maxLength": 500
        },
        "expected": {
          "type": "string",
          "$ref": "#/$defs/line",
          "minLength": 1,
          "maxLength": 500
        },
        "verdict": {
          "enum": [
            "passed",
            "failed",
            "not-reached"
          ]
        },
        "frames": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "finding": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "frame": {
      "type": "object",
      "required": [
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "enum": [
            "start",
            "reached"
          ]
        },
        "time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "file": {
          "type": "string",
          "pattern": "^scenario-[1-9][0-9]?-step-[1-8]\\.png$"
        }
      }
    },
    "version": {
      "type": "object",
      "required": [
        "type",
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "line": {
      "description": "One line of text: it has no control character, so no tab and no line break, no U+2028 or U+2029, and no Cf character but U+200C and U+200D, the joiners of emoji.",
      "type": "string",
      "pattern": "^[^\u0000-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890\u0891\u08e2\u180e\u200b\u200e\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]*$"
    }
  }
}
