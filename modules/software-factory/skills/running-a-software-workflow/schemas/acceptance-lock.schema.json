{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance lock, version 1",
  "description": "The hashes of the locked acceptance checks.",
  "type": "object",
  "required": [
    "criteria",
    "start_commit",
    "commit",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "start_commit": {
      "$ref": "#/$defs/commit"
    },
    "commit": {
      "$ref": "#/$defs/commit"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "support": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "criterion",
        "path",
        "sha256",
        "command",
        "failed_with"
      ],
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "type": "string",
          "pattern": "^ac-[1-9][0-9]{0,3}$"
        },
        "repository": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "failed_with": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "path": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^[^/\\s][^\\s]*$",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      },
      "allOf": [
        {
          "$ref": "#/$defs/line"
        }
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "line": {
      "description": "One line of text: no control character, no U+2028 or U+2029, and no Cf character but U+200C and U+200D (emoji joiners).",
      "type": "string",
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890\u0891\u08e2\u180e\u200b\u200e\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]*$"
    }
  }
}
