{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance lock, version 1",
  "description": "The hashes of the locked acceptance checks.",
  "type": "object",
  "required": [
    "criteria",
    "start_commit",
    "commit",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "start_commit": {
      "$ref": "#/$defs/commit"
    },
    "commit": {
      "$ref": "#/$defs/commit"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "support": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "criterion",
        "path",
        "sha256",
        "command",
        "failed_with"
      ],
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "type": "string",
          "pattern": "^ac-[1-9][0-9]?$"
        },
        "repository": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "failed_with": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "path": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^[^/\\s][^\\s]*$",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
