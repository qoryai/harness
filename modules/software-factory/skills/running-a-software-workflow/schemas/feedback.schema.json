{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feedback",
  "description": "What people asked for after they saw the change, sorted into points. A version keeps every source and point of the version before it.",
  "type": "object",
  "required": [
    "sources",
    "points"
  ],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "points": {
      "type": "array",
      "maxItems": 999,
      "items": {
        "$ref": "#/$defs/point"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "at",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "note",
            "comment",
            "answer"
          ]
        },
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9:.]+([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "by": {
          "type": "string",
          "$ref": "#/$defs/line",
          "minLength": 1,
          "maxLength": 500
        },
        "text": {
          "type": "string",
          "$ref": "https://qory.dev/contracts/harness/v1/primitives.schema.json#/$defs/text",
          "minLength": 1
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "id",
        "source",
        "quote",
        "sort",
        "change"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^p[1-9][0-9]{0,2}$"
        },
        "source": {
          "$ref": "#/$defs/source_id"
        },
        "quote": {
          "type": "string",
          "$ref": "https://qory.dev/contracts/harness/v1/primitives.schema.json#/$defs/text",
          "minLength": 1
        },
        "sort": {
          "enum": [
            "fix",
            "criterion-change",
            "question"
          ]
        },
        "output": {
          "enum": [
            "acceptance-criteria",
            "demo-scenarios"
          ]
        },
        "item": {
          "type": "string",
          "pattern": "^(ac|scenario)-[1-9][0-9]{0,3}$"
        },
        "change": {
          "type": "string",
          "$ref": "#/$defs/line",
          "minLength": 1,
          "maxLength": 500
        },
        "reply": {
          "type": "string",
          "$ref": "#/$defs/line",
          "minLength": 1,
          "maxLength": 1000
        },
        "question": {
          "type": "string",
          "pattern": "^q[1-9][0-9]{0,3}$"
        }
      }
    },
    "source_id": {
      "description": "The id of the note: gd_ or es_ of a note, rc_ of a comment, an_ of an answer. A comment or a reply with no id has cm_ and the first 16 hexadecimal digits of the SHA-256 of its at, a line feed and its text.",
      "type": "string",
      "pattern": "^(gd|es|rc|an)_[0-9a-z]{1,32}$|^cm_[0-9a-f]{16}$"
    },
    "line": {
      "$ref": "https://qory.dev/contracts/harness/v1/primitives.schema.json#/$defs/line"
    }
  }
}
