{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build ledger, version 1",
  "description": "Build's steps with their input hashes, and escalations.",
  "type": "object",
  "required": [
    "steps",
    "escalations"
  ],
  "additionalProperties": false,
  "properties": {
    "steps": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "escalations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/escalation"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "id",
        "pass",
        "kind",
        "workflow",
        "inputs",
        "state",
        "base",
        "attempts",
        "replays",
        "started_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z-]{4,12}(:[a-z0-9-]{1,40}(#[23])?)?$"
        },
        "pass": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "kind": {
          "enum": [
            "plan",
            "checks",
            "deliverable",
            "fix",
            "script",
            "small-change"
          ]
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "inputs": {
          "$ref": "#/$defs/sha256"
        },
        "state": {
          "enum": [
            "running",
            "done",
            "failed"
          ]
        },
        "base": {
          "$ref": "#/$defs/commit"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "script_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "attempts": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "pushed": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "report": {
          "type": "string",
          "maxLength": 8192
        },
        "replays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "started_at": {
          "$ref": "#/$defs/time"
        },
        "ended_at": {
          "$ref": "#/$defs/time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "done"
              }
            }
          },
          "then": {
            "required": [
              "commit",
              "ended_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "script"
              },
              "state": {
                "const": "done"
              }
            }
          },
          "then": {
            "required": [
              "script_sha256"
            ]
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "required": [
        "agent",
        "role",
        "tier",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/name"
        },
        "role": {
          "$ref": "#/$defs/name"
        },
        "tier": {
          "enum": [
            "light",
            "fast",
            "thinking"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[!-~]+$"
        }
      }
    },
    "escalation": {
      "type": "object",
      "required": [
        "workflow",
        "reason",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "reason": {
          "enum": [
            "short-path",
            "plan-limit",
            "ledger-full",
            "check-judged-wrong",
            "findings-open",
            "preflight",
            "no-agent",
            "other"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 1000
        },
        "at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "version": {
      "type": "object",
      "required": [
        "type",
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 32
    },
    "workflow": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,54}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9:.]+([Zz]|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
