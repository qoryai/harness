{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Submission, version 1",
  "description": "A session's branch, commits, draft, text and verdict.",
  "type": "object",
  "required": [
    "ref",
    "repositories",
    "verdict"
  ],
  "additionalProperties": false,
  "properties": {
    "ref": {
      "title": "Branch",
      "type": "string",
      "pattern": "^qory/wi_[A-Za-z0-9_-]{1,64}$"
    },
    "verdict": {
      "enum": [
        "passed",
        "changes-requested",
        "escalate",
        "none"
      ]
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "text": {
      "$ref": "#/$defs/text"
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "required": [
        "system",
        "path",
        "commit"
      ],
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^[a-z0-9.-]{0,252}[a-z0-9-]$"
        },
        "path": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": {
            "pattern": "(^|/)(\\.\\.?|\\.[Gg][Ii][Tt])(/|$)"
          }
        },
        "commit": {
          "title": "Commit",
          "$ref": "#/$defs/commit"
        },
        "commit_url": {
          "title": "Commit link",
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://\\S+$"
        },
        "base": {
          "type": "object",
          "required": [
            "commit"
          ],
          "additionalProperties": false,
          "properties": {
            "commit": {
              "$ref": "#/$defs/commit"
            },
            "branch": {
              "type": "string",
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x20\\x7f~^:?*\\[\\\\/-][^\\x00-\\x20\\x7f~^:?*\\[\\\\]*$",
              "not": {
                "pattern": "\\.\\.|//|@\\{|(^|/)\\.|\\.lock(/|$)|[./]$|^@$"
              }
            },
            "commit_url": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https://\\S+$"
            }
          }
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "commit",
              "step"
            ],
            "additionalProperties": false,
            "properties": {
              "commit": {
                "$ref": "#/$defs/commit"
              },
              "step": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\x00]*$"
              },
              "commit_url": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https://\\S+$"
              }
            }
          }
        },
        "draft": {
          "oneOf": [
            {
              "$ref": "#/$defs/draft"
            },
            {
              "$ref": "#/$defs/no_draft"
            }
          ]
        }
      }
    },
    "draft": {
      "type": "object",
      "required": [
        "number",
        "url",
        "title",
        "state",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "title": "Draft",
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "title": "Draft link",
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://\\S+$"
        },
        "title": {
          "title": "Draft title",
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "state": {
          "enum": [
            "draft",
            "open",
            "closed",
            "merged"
          ]
        },
        "action": {
          "enum": [
            "opened",
            "updated",
            "kept"
          ]
        }
      }
    },
    "no_draft": {
      "type": "object",
      "required": [
        "none"
      ],
      "additionalProperties": false,
      "properties": {
        "none": {
          "title": "No draft",
          "enum": [
            "not-passed",
            "no-text",
            "escalated",
            "no-program",
            "program-failed",
            "program-timeout",
            "login-needed"
          ]
        },
        "exit": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "none": {
                "const": "program-failed"
              }
            }
          },
          "then": {
            "required": [
              "exit"
            ],
            "properties": {
              "exit": {
                "enum": [
                  0,
                  1,
                  2
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "none": {
                "const": "login-needed"
              }
            }
          },
          "then": {
            "required": [
              "exit"
            ],
            "properties": {
              "exit": {
                "const": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "none": {
                "enum": [
                  "not-passed",
                  "no-text",
                  "escalated",
                  "no-program",
                  "program-timeout"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "exit"
              ]
            }
          }
        }
      ]
    },
    "text": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\u00ad\u061c\u180e\u200b\u200e\u200f\u2028\u2029\u202a-\u202e\u2060-\u2064\u2066-\u2069\ufeff\ufff9-\ufffb]+$",
          "allOf": [
            {
              "pattern": "[^ \u00a0\u1680\u2000-\u200a\u202f\u205f\u3000]"
            }
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^[^\\x00]*$",
          "not": {
            "pattern": "(^|\\n)<!-- qory:(start|end) -->"
          }
        }
      }
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    }
  }
}
