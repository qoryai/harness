{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node \"$QORY_HARNESS_HOME/hooks/reports-guard-cursor.js\"",
        "matcher": "Write|Delete",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node \"$QORY_HARNESS_HOME/hooks/reports-guard-cursor.js\"",
        "matcher": "[.][Rr]|[*?[{$`'\"\\\\~]|\\beval\\b",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node \"$QORY_HARNESS_HOME/hooks/end-gate-cursor.js\"",
        "timeout": 180
      }
    ]
  }
}
