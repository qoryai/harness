{
  "disableAllHooks": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$QORY_RUN_ID\" ] || /usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u LD_PRELOAD -u LD_AUDIT -u LD_LIBRARY_PATH -u NODE_COMPILE_CACHE -u OPENSSL_CONF node \"$QORY_HARNESS_HOME/hooks/tool-guard-claude.cjs\" || { echo 'Report this error in your output: the tool guard did not run.' >&2; exit 2; }",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u LD_PRELOAD -u LD_AUDIT -u LD_LIBRARY_PATH -u NODE_COMPILE_CACHE -u OPENSSL_CONF node \"$QORY_HARNESS_HOME/hooks/tool-guard-claude.cjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u LD_PRELOAD -u LD_AUDIT -u LD_LIBRARY_PATH -u NODE_COMPILE_CACHE -u OPENSSL_CONF node \"$QORY_HARNESS_HOME/hooks/end-gate-claude.cjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Skill(harness:running-a-workflow)",
      "Skill(harness:artifact-text)",
      "Skill(harness:checking-questions)",
      "Skill(harness:reading-the-work)",
      "Skill(harness:replying-to-comments)",
      "Skill(harness:reviewing-changes)",
      "Skill(harness:reviewing-drafts)",
      "Skill(harness:run-artifacts)",
      "Skill(harness:simple-communication)",
      "Skill(harness:visuals)",
      "Skill(harness:writing-questions)",
      "Agent(harness:questions-writer)",
      "Agent(harness:questions-reviewer)",
      "Agent(harness:reply-writer)",
      "Bash($QORY_HARNESS_HOME/claude/plugin/skills/running-a-workflow/versions.cjs *)",
      "Bash($QORY_HARNESS_HOME/claude/plugin/skills/running-a-workflow/checks.cjs *)"
    ],
    "deny": [
      "Edit(//tmp/qory-artifacts/.reports/**/*.json)",
      "Edit(/.qory/artifacts/.reports/**/*.json)",
      "Edit(./.qory/artifacts/.reports/**/*.json)",
      "Edit(//tmp/qory-artifacts/.reports/*.json.lock*)",
      "Edit(/.qory/artifacts/.reports/*.json.lock*)",
      "Edit(./.qory/artifacts/.reports/*.json.lock*)"
    ]
  }
}
