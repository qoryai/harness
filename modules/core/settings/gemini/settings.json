{
  "security": {
    "environmentVariableRedaction": {
      "allowed": [
        "QORY_RUN_ID",
        "QORY_RUN_API",
        "QORY_SESSION",
        "QORY_HARNESS_HOME",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy"
      ]
    }
  },
  "advanced": {
    "excludedEnvVars": [
      "NODE_OPTIONS",
      "NODE_PATH",
      "LD_PRELOAD",
      "LD_AUDIT",
      "BASH_ENV",
      "ENV"
    ]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "write_file|replace|run_shell_command",
        "hooks": [
          {
            "name": "reports-guard",
            "type": "command",
            "command": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u LD_PRELOAD -u LD_AUDIT -u LD_LIBRARY_PATH node \"$QORY_HARNESS_HOME/hooks/reports-guard-gemini.cjs\"",
            "env": {
              "BASH_ENV": "",
              "ENV": "",
              "SHELLOPTS": "",
              "BASHOPTS": "",
              "PS4": "",
              "LD_PRELOAD": "",
              "LD_AUDIT": "",
              "LD_LIBRARY_PATH": ""
            },
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "end-gate",
            "type": "command",
            "command": "/usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u LD_PRELOAD -u LD_AUDIT -u LD_LIBRARY_PATH node \"$QORY_HARNESS_HOME/hooks/end-gate-gemini.cjs\"",
            "env": {
              "BASH_ENV": "",
              "ENV": "",
              "SHELLOPTS": "",
              "BASHOPTS": "",
              "PS4": "",
              "LD_PRELOAD": "",
              "LD_AUDIT": "",
              "LD_LIBRARY_PATH": ""
            },
            "timeout": 180000
          }
        ]
      }
    ]
  }
}
